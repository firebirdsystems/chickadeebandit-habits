{
  "id": "habits",
  "name": "Habits",
  "version": "1.0.0",
  "description": "Build lasting habits with flexible frequency, grace days, and pause support. Daily, weekday, or X-per-week goals that forgive occasional misses so you keep going.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": ["habits", "wellness", "fitness", "goals", "streaks"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "nav": {
    "label": "Habits"
  },
  "storage": "db",
  "row_policies": {
    "habits": {
      "kind": "owner_or_visibility",
      "member_column": "owner_id",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "adult_values": ["adults", "everyone"],
      "write_owner_only": true
    },
    "logs": {
      "kind": "inherit_visibility",
      "fk_column": "habit_id",
      "parent_table": "habits",
      "writer_column": "logged_by",
      "insert_non_owner_parent_truthy_column": "is_group",
      "retain_days": { "default": 365, "timestamp_column": "created_at", "override_key": "habit_history" }
    },
    "pauses": {
      "kind": "inherit_visibility",
      "fk_column": "habit_id",
      "parent_table": "habits",
      "writer_column": "owner_id",
      "insert_owner_only": true
    }
  },
  "db_plaintext_columns": ["logged_date", "start_date", "end_date"],
  "exports": ["member-habits"],
  "publishes": ["habit.milestone"],
  "widget": { "label": "Habits", "size": "small" },
  "resource_limits": { "max_db_bytes": 52428800 },
  "icon": "✅",
  "ai_access": {
    "allowed": true,
    "mode": "read_write",
    "db_exports": ["active_habits", "todays_completions"],
    "db_inserts": ["log_habit"],
    "db_deletes": ["unlog_habit"]
  }
}
